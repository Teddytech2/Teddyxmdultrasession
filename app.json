{
  "name": "TEDDY-XMD Session Server",
  "description": "TEDDY-XMD WhatsApp session generator and session storage API",
  "logo": "https://files.catbox.moe/52699c.jpg",
  "repository": "https://github.com/Teddyxmd/TEDDY-XMD",
  "keywords": [
    "teddy-xmd",
    "whatsapp",
    "session"
  ],
  "success_url": "/",
  "buildpacks": [
    {
      "url": "https://github.com/heroku/heroku-buildpack-nodejs#latest"
    }
  ],
  "env": {
    "PORT": {
      "description": "Port for web app.4000,5000,3000... any!",
      "value": "50900",
      "required": false
    },
    "DATABASE_URL": {
      "description": "MongoDB Atlas or PostgreSQL connection URL used to persist sessions",
      "required": true
    }
  }
}
